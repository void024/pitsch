# ---- LLM ----
# Gemini (recommended for the demo). Get a key at https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini sets the endpoint, leaves temperature at Gemini's default and uses
# low reasoning effort. Run `python -m scripts.check_llm --list-models` to see valid model IDs.
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-flash-latest

# Optional: a different model per agent (empty = LLM_MODEL), e.g. a lite model for the classifier
# or a Pro model for analysis.
CLASSIFIER_LLM_MODEL=
DOCUMENT_LLM_MODEL=
RESEARCH_LLM_MODEL=
VERIFICATION_LLM_MODEL=
ANALYSIS_LLM_MODEL=
EMAIL_RESPONSE_LLM_MODEL=
CALENDAR_LLM_MODEL=

# Other OpenAI-compatible providers: set LLM_PROVIDER=other (or openai) and LLM_BASE_URL, e.g.
#   OpenAI: leave LLM_BASE_URL empty
#   Groq:   https://api.groq.com/openai/v1
#   Ollama: http://localhost:11434/v1
# LLM_BASE_URL=
# LLM_TEMPERATURE=0          # empty = provider default (required for Gemini 3)
# LLM_REASONING_EFFORT=low   # none | minimal | low | medium | high (empty = provider default)
# LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_JSON_MODE=true

# ---- Email Classifier ----
CLASSIFIER_REVIEW_THRESHOLD=0.75
CLASSIFIER_MAX_BODY_CHARS=12000

# ---- Document Agent ----
DOCUMENT_MAX_CHARS=40000
DOCUMENT_MAX_FILE_MB=15

# ---- Research Agent (web search) ----
# Get a free key at https://tavily.com. Without a key, research runs with no web evidence.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEARCH_RESULTS_PER_QUERY=5
RESEARCH_MAX_QUERIES=8
RESEARCH_MAX_ROUNDS=2
RESEARCH_STALENESS_DAYS=365

# ---- Action Agent ----
GMAIL_LABEL_PREFIX=Pitsch

LOG_LEVEL=INFO
