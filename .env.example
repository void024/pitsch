# Root .env for `docker compose` (local, production-like stack). Generate one with scripts/gen-dev-env.sh.
# Per-service references: backend/.env.example, ai-service/.env.example, frontend/.env.example.

# demo = mock Google providers + seeded demo workspace | development = no mocks (connect real Google)
PITSCH_MODE=demo

POSTGRES_PASSWORD=
MINIO_ROOT_USER=pitsch
MINIO_ROOT_PASSWORD=

JWT_SECRET=                 # openssl rand -base64 48
PITSCH_ENCRYPTION_KEYS=     # k1:$(openssl rand -base64 32)
AI_SERVICE_TOKEN=           # openssl rand -base64 48

LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=
TAVILY_API_KEY=

# Optional: real Google (development mode). Redirect URI: http://localhost:3000/api/v1/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
