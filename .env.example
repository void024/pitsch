# ---- LLM (any OpenAI-compatible provider) ----
LLM_API_KEY=your-key-here
LLM_MODEL=your-model-name

# Leave LLM_BASE_URL unset for OpenAI. For other OpenAI-compatible providers:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:   https://api.groq.com/openai/v1
#   Ollama: http://localhost:11434/v1
# LLM_BASE_URL=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_JSON_MODE=true

# ---- Email Classifier ----
CLASSIFIER_REVIEW_THRESHOLD=0.75
CLASSIFIER_MAX_BODY_CHARS=12000

# ---- Document Agent ----
DOCUMENT_MAX_CHARS=40000
DOCUMENT_MAX_FILE_MB=15

# ---- Research Agent (web search) ----
# Get a free key at https://tavily.com. Without a key, research runs with no web evidence.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEARCH_RESULTS_PER_QUERY=5
RESEARCH_MAX_QUERIES=8
RESEARCH_MAX_ROUNDS=2
RESEARCH_STALENESS_DAYS=365

# ---- Action Agent ----
GMAIL_LABEL_PREFIX=Pitsch

LOG_LEVEL=INFO
