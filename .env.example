LLM_API_KEY=your-key-here
LLM_MODEL=your-model-name

# Leave LLM_BASE_URL unset for OpenAI. For other OpenAI-compatible providers:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:   https://api.groq.com/openai/v1
#   Ollama: http://localhost:11434/v1
# LLM_BASE_URL=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_JSON_MODE=true
CLASSIFIER_REVIEW_THRESHOLD=0.75
CLASSIFIER_MAX_BODY_CHARS=12000
LOG_LEVEL=INFO
