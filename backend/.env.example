# Copy to backend/.env (never commit .env). Everything is optional for local demos.

# PostgreSQL (leave commented to use the built-in H2 file database)
# DB_URL=jdbc:postgresql://localhost:5432/pitsch
# DB_USERNAME=postgres
# DB_PASSWORD=your-password

# Where the Pitsch AI service runs
AI_SERVICE_URL=http://localhost:8000

# JWT signing secret — use 32+ random characters outside local development
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me

# Frontend origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

DEFAULT_TIMEZONE=Asia/Kolkata
SEED_DEMO_USER=true
