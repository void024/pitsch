# ==============================================================================================
# Pitsch backend configuration (Spring Boot). Copy to backend/.env for local runs — the backend reads it
# automatically. In production, set real environment variables from your platform's secret store and
# never commit a filled-in .env. Full reference: docs/DEPLOYMENT.md.
#
# Generate secrets:
#   JWT_SECRET              openssl rand -base64 48
#   PITSCH_ENCRYPTION_KEYS  echo "k1:$(openssl rand -base64 32)"
#   AI_SERVICE_TOKEN        openssl rand -base64 48   (must equal the AI service's AI_SERVICE_TOKEN)
# ==============================================================================================

# ---- Mode ----
# production (default, strict, fails fast on unsafe config) | development (H2, logged mail, local files)
# | demo (development + mock Google providers + a seeded "Demo Capital" workspace, labelled in the UI)
PITSCH_MODE=development
PORT=8080

# ---- Database: PostgreSQL in every real environment (H2 file DB is the dev/demo default) ----
# DB_URL=jdbc:postgresql://localhost:5432/pitsch
# DB_USERNAME=pitsch
# DB_PASSWORD=
# DB_POOL_SIZE=10

# ---- Public URLs (https in production) ----
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
# Exact origins, comma-separated. No "*". Same-site deployments (SPA proxies /api) need only the SPA origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Auth & security ----
# Required in production (>= 43 chars of base64 = 32 bytes). Empty outside production = ephemeral secret.
JWT_SECRET=
# JWT_ISSUER=pitsch
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30
# REFRESH_REUSE_GRACE_SECONDS=20
# PASSWORD_HASH_ITERATIONS=600000
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# REQUIRE_EMAIL_VERIFICATION=true
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=Lax              # use None only for split-origin deployments (requires COOKIE_SECURE=true)
# COOKIE_DOMAIN=
# AES-256-GCM keys for OAuth tokens at rest: "keyId:base64(32 bytes)", comma-separated, newest first.
# Required in production. Keep old keys listed until rotation re-encrypts (docs/OPERATIONS.md).
PITSCH_ENCRYPTION_KEYS=

# ---- Rate limits (per instance) ----
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_API_PER_MINUTE=600
# RATE_LIMIT_AI_PER_MINUTE=30

# ---- AI service ----
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
# AI_READ_TIMEOUT_SECONDS=240

# ---- Google (Gmail, Calendar, Sheets, optional sign-in). Leave empty to run without Google. ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/google/callback
# GOOGLE_LOGIN_ENABLED=false
# Gmail push (optional; without it Gmail is polled every GMAIL_SYNC_INTERVAL_MINUTES)
# GOOGLE_PUBSUB_TOPIC=projects/<project>/topics/<topic>
# GOOGLE_PUBSUB_AUDIENCE=https://api.example.com/api/v1/webhooks/gmail
# GOOGLE_PUBSUB_SERVICE_ACCOUNT=
# GMAIL_SYNC_INTERVAL_MINUTES=10
# GMAIL_INGEST_QUERY=in:inbox -category:promotions -category:social -category:forums
# GOOGLE_API_TIMEOUT_SECONDS=20

# ---- File storage: s3 (production) | local (development/demo only) ----
# STORAGE_PROVIDER=s3
# STORAGE_LOCAL_DIR=./data/files
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=                      # R2 / MinIO / other S3-compatible endpoints
# S3_PUBLIC_ENDPOINT=               # host used in presigned download links, if different (e.g. MinIO in Docker)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE=false               # true for MinIO
# SIGNED_URL_MINUTES=10

# ---- Upload limits & malware scanning ----
# UPLOAD_MAX_FILE_MB=15
# UPLOAD_MAX_FILES=10
# UPLOAD_MAX_PPTX_UNCOMPRESSED_MB=150
# UPLOAD_MAX_ZIP_ENTRIES=3000
# MALWARE_SCANNER=none              # none | clamav
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# ---- Transactional email: smtp (production) | log (development/demo: printed, not sent) ----
# MAIL_PROVIDER=smtp
# MAIL_FROM=Pitsch <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# ---- Background jobs (PostgreSQL queue) ----
# JOBS_ENABLED=true                 # set false on API-only replicas if you run dedicated workers
# JOB_THREADS=4
# JOB_POLL_INTERVAL_MS=1000
# JOB_LOCK_TIMEOUT_MINUTES=20

# ---- Billing: none (plans set in the database) | stripe ----
# BILLING_PROVIDER=none
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_IDS=STARTER=price_...,TEAM=price_...

# ---- Privacy / retention ----
# AGENT_IO_RETENTION_DAYS=90
# AUDIT_RETENTION_DAYS=730

# ---- Misc ----
DEFAULT_TIMEZONE=UTC
# API_DOCS_ENABLED=false            # Swagger UI at /api/docs; on by default only in development/demo
# MANAGEMENT_PORT=8081              # actuator (health probes, Prometheus) on a separate, private port
# FORWARD_HEADERS_STRATEGY=framework
# DEMO_PASSWORD=                    # demo mode only; default documented in README
