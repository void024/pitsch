# Pitsch frontend (Vite). Only VITE_* variables reach the browser bundle — never put secrets here.

# API base. Default "/api" = same origin (recommended: serve SPA and API under one site; nginx/Vite proxy /api).
# Set an absolute URL only for a split-origin deployment, and configure the backend CORS_ALLOWED_ORIGINS and
# COOKIE_SAME_SITE accordingly (see docs/DEPLOYMENT.md).
VITE_API_BASE_URL=/api

# Show "Continue with Google" on the sign-in page (the backend must have Google OAuth configured).
VITE_GOOGLE_LOGIN=false

# Show the demo-credentials hint on the sign-in page. Only for PITSCH_MODE=demo deployments.
VITE_DEMO_MODE=false

# Development only: where the Vite dev server proxies /api.
VITE_DEV_API_TARGET=http://localhost:8080

# E2E only: use a preinstalled Chromium instead of `npx playwright install`.
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
