# ==============================================================================================
# Pitsch AI service configuration. Copy to .env for local runs; in production set real environment
# variables in your platform's secret store (never commit a filled-in .env).
# ==============================================================================================

# ---- Service ----
# production (default): AI_SERVICE_TOKEN is mandatory and /docs is off. development | test relax both.
PITSCH_MODE=development
# Shared secret; must equal the backend's AI_SERVICE_TOKEN. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
AI_SERVICE_TOKEN=
# API_DOCS_ENABLED=false     # default: on outside production
MAX_REQUEST_MB=30

# ---- LLM ----
# Gemini (recommended for the demo). Get a key at https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini sets the endpoint, leaves temperature at Gemini's default and uses
# low reasoning effort. Run `python -m scripts.check_llm --list-models` to see valid model IDs.
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-flash-latest

# Optional: a different model per agent (empty = LLM_MODEL), e.g. a lite model for the classifier
# or a Pro model for analysis.
CLASSIFIER_LLM_MODEL=
DOCUMENT_LLM_MODEL=
RESEARCH_LLM_MODEL=
VERIFICATION_LLM_MODEL=
ANALYSIS_LLM_MODEL=
EMAIL_RESPONSE_LLM_MODEL=
CALENDAR_LLM_MODEL=

# Other OpenAI-compatible providers: set LLM_PROVIDER=other (or openai) and LLM_BASE_URL, e.g.
#   OpenAI: leave LLM_BASE_URL empty
#   Groq:   https://api.groq.com/openai/v1
#   Ollama: http://localhost:11434/v1
# LLM_BASE_URL=
# LLM_TEMPERATURE=0          # empty = provider default (required for Gemini 3)
# LLM_REASONING_EFFORT=low   # none | minimal | low | medium | high (empty = provider default)
# LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_JSON_MODE=true
# Upper bound on generated tokens per call (0 = provider default)
LLM_MAX_OUTPUT_TOKENS=16000
# Optional fallback model used only when the primary fails with a provider error (outage, 5xx, 429, unknown model)
LLM_FALLBACK_MODEL=
# Cost estimates in meta.estimatedCostUsd, USD per million tokens: "model=input/output;model2=input/output".
# Check your provider's current price list; unlisted models report no cost.
LLM_PRICES=

# ---- Email Classifier ----
CLASSIFIER_REVIEW_THRESHOLD=0.75
CLASSIFIER_MAX_BODY_CHARS=12000

# ---- Document Agent ----
DOCUMENT_MAX_CHARS=40000
DOCUMENT_MAX_FILE_MB=15

# ---- Research Agent (web search) ----
# Get a free key at https://tavily.com. Without a key, research runs with no web evidence.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEARCH_RESULTS_PER_QUERY=5
RESEARCH_MAX_QUERIES=8
RESEARCH_MAX_ROUNDS=2
RESEARCH_STALENESS_DAYS=365
RESEARCH_DEADLINE_SECONDS=150

# ---- Action Agent ----
GMAIL_LABEL_PREFIX=Pitsch

LOG_LEVEL=INFO
